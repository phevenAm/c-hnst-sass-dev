#!/usr/bin/env bash

echo ""
echo "-- Pre-push: version bump check ----------------------------"
CURRENT=$(node -e "console.log(require('./package.json').version)")
MAIN=$(git show main:package.json 2>/dev/null | node -e "
  let d=''; process.stdin.on('data',c=>d+=c);
  process.stdin.on('end',()=>{ try{console.log(JSON.parse(d).version)}catch(e){} });
")

if [ -z "$MAIN" ]; then
  echo "OK (no main branch to compare against)"
elif [ "$CURRENT" = "$MAIN" ]; then
  echo ""
  echo "  ERROR: version in package.json ($CURRENT) is the same as main."
  echo "  Bump the version before pushing — edit \"version\" in package.json"
  echo ""
  exit 1
else
  echo "OK $MAIN → $CURRENT"
fi
echo ""

echo "-- Pre-push: CSV template sync check ------------------------"
node scripts/check-csv-template.js
if [ $? -ne 0 ]; then
  echo "  Update HEADERS in ImportStubsModal.tsx to match StubSession fields."
  echo ""
  exit 1
fi
echo ""

echo "-- Pre-push: migration sync check ---------------------------"
MIGRATION_JSON=$(npx supabase migration list 2>/dev/null)

PENDING=$(echo "$MIGRATION_JSON" | node -e "
  let d = '';
  process.stdin.on('data', c => d += c);
  process.stdin.on('end', () => {
    try {
      const j = JSON.parse(d);
      const p = (j.migrations || []).filter(m => m.local && !m.remote).map(m => m.local);
      if (p.length) console.log(p.join(', '));
    } catch(e) {}
  });
" 2>/dev/null)

if [ -n "$PENDING" ]; then
  echo ""
  echo "  WARNING: local migrations not yet applied to remote Supabase:"
  echo "  $PENDING"
  echo ""
  echo "  Run: npx supabase db push"
  echo ""
else
  echo "OK all migrations in sync"
fi
echo ""
